{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["esnext", "dom"],
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-native",
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["@types/react", "react-native"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "App.tsx", "index.tsx"],
  "exclude": ["node_modules", "dist", "build", "ios", "android"]
}
