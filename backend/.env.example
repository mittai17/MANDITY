# Mandity Backend — Environment Variables
# Copy to .env and fill in your values.

# Supabase (server-side — service role key, never expose to mobile)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Gemini API (for voice AI explanations)
GEMINI_API_KEY=your-gemini-api-key-here

# AGMARKNET data integration (optional)
AGMARKNET_API_KEY=your-agmarknet-key-here

# API server
PORT=8000
HOST=0.0.0.0
